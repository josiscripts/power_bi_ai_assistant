# Server Configuration
PORT=3000
NODE_ENV=development

# Claude API Key - Get from https://console.anthropic.com
CLAUDE_API_KEY=your_claude_api_key_here

# Power BI Configuration
POWER_BI_API_KEY=your_power_bi_api_key_here
POWER_BI_TENANT_ID=your_tenant_id_here

# CORS Origins - Multiple origins separated by comma
# Development: http://localhost:5173,http://localhost:3000
# Production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (optional)
# MongoDB:
DATABASE_URL=mongodb://localhost:27017/powerbi-ai
# PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/powerbi_ai

# Logging Level
LOG_LEVEL=debug
