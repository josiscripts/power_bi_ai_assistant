# Servidor
PORT=3000
NODE_ENV=development

# Claude API
CLAUDE_API_KEY=your_claude_api_key_here

# Power BI
POWER_BI_API_KEY=your_power_bi_api_key_here
POWER_BI_TENANT_ID=your_tenant_id_here

# CORS
CORS_ORIGIN=http://localhost:5173

# Database (si usas una)
